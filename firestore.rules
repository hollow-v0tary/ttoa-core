rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function own(uid) { return signed() && request.auth.uid == uid; }
    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 32; }
    function partyExists(pid) {
      return pid is string && pid.size() > 4 && pid.size() <= 20
        && exists(/databases/$(database)/documents/parties/$(pid));
    }
    function member(pid) {
      return signed() && partyExists(pid)
        && request.auth.uid in get(/databases/$(database)/documents/parties/$(pid)).data.memberIds;
    }
    function leader(pid) {
      return signed() && partyExists(pid)
        && get(/databases/$(database)/documents/parties/$(pid)).data.leaderId == request.auth.uid;
    }
    function nullableId(v) { return v == null || (v is string && v.size() <= 48); }
    function validPartyAddition(pid) {
      let fresh = request.resource.data.memberIds.removeAll(resource.data.memberIds);
      return fresh.size() == 0 || (fresh.size() == 1
        && exists(/databases/$(database)/documents/parties/$(pid)/requests/$(fresh[0]))
        && get(/databases/$(database)/documents/parties/$(pid)/requests/$(fresh[0])).data.status == 'pending');
    }

    // Privileged Director accounts are added ONLY from Firebase Console / Admin SDK.
    // A regular user may read their own assignment, never create or modify it.
    function siteAdmin(){
      return signed()
        && exists(/databases/$(database)/documents/siteAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data.enabled == true;
    }
    match /siteAdmins/{uid} {
      allow get: if own(uid);
      allow list, create, update, delete: if false;
    }
    // Public published content. Writes require the separate protected role.
    match /siteContent/{contentId} {
      allow get, list: if true;
      allow create, update: if siteAdmin()
        && contentId.matches('^(core|race|class|world|section)-[a-z0-9-]{1,56}$')
        && request.resource.data.keys().hasOnly(['title','description','imageUrl','meta','blocks','updatedAt'])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 150))
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 4000))
        && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2048))
        && (!('meta' in request.resource.data) || (request.resource.data.meta is map && request.resource.data.meta.size() <= 20))
        && (!('blocks' in request.resource.data) || (request.resource.data.blocks is map && request.resource.data.blocks.size() <= 160))
        && request.resource.data.updatedAt == request.time;
      allow delete: if siteAdmin();
    }

    // Director's structured design registry. NOT PUBLIC: drafts and ready entries
    // do not automatically change published player-facing rules or characters.
    match /directorDrafts/{draftId} {
      allow get, list: if siteAdmin();
      allow create, update: if siteAdmin()
        && draftId.matches('^(class|race|path|skill|item|artifact|rule|region|monster|encounter)-[a-z0-9][a-z0-9-]{0,47}$')
        && request.resource.data.keys().hasOnly([
          'kind','title','summary','mechanic','parent','status','cost','limit',
          'level','rarity','imageUrl','blocks','updatedAt','updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'kind','title','summary','mechanic','parent','status','cost','limit',
          'level','rarity','imageUrl','blocks','updatedAt','updatedBy'
        ])
        && request.resource.data.kind in [
          'class','race','path','skill','item','artifact','rule','region','monster','encounter'
        ]
        && draftId.matches('^' + request.resource.data.kind + '-[a-z0-9][a-z0-9-]{0,47}$')
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 120
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 1200
        && request.resource.data.mechanic is string && request.resource.data.mechanic.size() <= 6000
        && request.resource.data.parent is string && request.resource.data.parent.size() <= 64
        && request.resource.data.cost is string && request.resource.data.cost.size() <= 120
        && request.resource.data.limit is string && request.resource.data.limit.size() <= 120
        && request.resource.data.level is string && request.resource.data.level.size() <= 64
        && request.resource.data.rarity is string && request.resource.data.rarity.size() <= 64
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 300
        && (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('^[.]/assets/[a-zA-Z0-9/_-]+[.](webp|jpg|jpeg|png)$'))
        && request.resource.data.blocks is list && request.resource.data.blocks.size() <= 30
        && request.resource.data.status in ['draft','review','ready']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if siteAdmin();
    }

    match /users/{uid} {
      // Preserve the original registration contract; account registration still works.
      allow get: if own(uid);
      allow list, delete: if false;
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['uid','displayName','createdAt'])
        && request.resource.data.keys().hasAll(['uid','displayName','createdAt'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validName(request.resource.data.displayName);

      match /settings/{settingId} {
        allow get: if own(uid);
        allow list, delete: if false;
        allow create, update: if own(uid) && (
          (settingId == 'playerState'
            && request.resource.data.keys().hasOnly(['activeCharacterId','partyId','pendingPartyId'])
            && (!('activeCharacterId' in request.resource.data) || nullableId(request.resource.data.activeCharacterId))
            && (!('partyId' in request.resource.data) ||
              (nullableId(request.resource.data.partyId)
               && (request.resource.data.partyId == null || member(request.resource.data.partyId))))
            && (!('pendingPartyId' in request.resource.data) || nullableId(request.resource.data.pendingPartyId)))
          ||
          (settingId == 'notifications'
            && request.resource.data.keys().hasOnly(['emailOptIn','email','consentVersion','updatedAt'])
            && request.resource.data.keys().hasAll(['emailOptIn','email','consentVersion','updatedAt'])
            && request.resource.data.emailOptIn is bool
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.consentVersion == 'v1'
            && request.resource.data.updatedAt == request.time)
        );
      }

      match /characters/{characterId} {
        allow get, list: if own(uid);
        allow create: if own(uid) && validCharacter(uid)
          && request.resource.data.createdAt == request.time;
        allow update: if own(uid) && validCharacter(uid)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && (!(('schemaVersion' in resource.data) && resource.data.schemaVersion == 2)
              || request.resource.data.schemaVersion == 2);
        allow delete: if own(uid);

        // Character Builder V2 is an additive schema. Existing V1 characters stay valid.
        // All new personal character data stays nested under the authenticated UID.
        function validCharacter(ownerId) {
          let d = request.resource.data;
          return d.keys().hasOnly([
              'schemaVersion','ownerId','name','bio','raceId','classId','level',
              'attributes','baseSkills','pathIndex','pathSkills','health','healthMax',
              'mana','manaMax','speed','defense','artData','inventory','equipped','createdAt','updatedAt',
              'appearance','progression','derivedStats','wallet','equipmentSlots','rulesetVersion'
            ])
            && d.keys().hasAll([
              'ownerId','name','bio','raceId','classId','level','attributes','baseSkills',
              'pathIndex','pathSkills','health','healthMax','mana','manaMax','speed',
              'defense','artData','inventory','equipped','updatedAt'
            ])
            && d.ownerId == ownerId
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
            && d.bio is string && d.bio.size() <= 400
            && d.raceId is string && d.raceId.size() <= 48
            && d.classId is string && d.classId.size() <= 48
            && d.level is int && d.level >= 1 && d.level <= 10
            && d.attributes is map && d.attributes.size() == 6
            && d.baseSkills is list && d.baseSkills.size() <= 3
            && d.pathIndex is int && d.pathIndex >= -1 && d.pathIndex <= 4
            && d.pathSkills is list && d.pathSkills.size() <= 2
            && d.artData is string && d.artData.size() <= 170000
            && d.health is number && d.health >= 0 && d.health <= 9999
            && d.healthMax is number && d.healthMax >= 0 && d.healthMax <= 9999
            && d.mana is number && d.mana >= 0 && d.mana <= 9999
            && d.manaMax is number && d.manaMax >= 0 && d.manaMax <= 9999
            && d.speed is number && d.speed >= 0 && d.speed <= 100
            && d.defense is number && d.defense >= 0 && d.defense <= 100
            && d.inventory is list && d.inventory.size() <= 20
            && d.equipped is list && d.equipped.size() <= 20
            && d.updatedAt == request.time
            && (
              ( (!('schemaVersion' in d) || d.schemaVersion == 1)
                && !('appearance' in d) && !('progression' in d)
                && !('derivedStats' in d) && !('wallet' in d)
                && !('equipmentSlots' in d) && !('rulesetVersion' in d)
              )
              || validCharacterV2(d)
            );
        }

        function validCharacterV2(d) {
          return d.schemaVersion == 2
            && d.keys().hasAll([
              'appearance','progression','derivedStats','wallet','equipmentSlots','rulesetVersion'
            ])
            && d.rulesetVersion is string && d.rulesetVersion.size() <= 32
            && d.appearance is map
            && d.appearance.keys().hasOnly(['goal','notes','portraitAssetPath'])
            && d.appearance.keys().hasAll(['goal','notes','portraitAssetPath'])
            && d.appearance.goal is string && d.appearance.goal.size() <= 400
            && d.appearance.notes is string && d.appearance.notes.size() <= 700
            && d.appearance.portraitAssetPath is string
            && d.appearance.portraitAssetPath.size() <= 256
            && d.progression is map
            && d.progression.keys().hasOnly([
              'pathId','breakthroughCompleted','trueClassId','trueClassSkills','levelHistory'
            ])
            && d.progression.keys().hasAll([
              'pathId','breakthroughCompleted','trueClassId','trueClassSkills','levelHistory'
            ])
            && d.progression.pathId is string && d.progression.pathId.size() <= 64
            && d.progression.breakthroughCompleted is bool
            && d.progression.trueClassId is string && d.progression.trueClassId.size() <= 64
            && d.progression.trueClassSkills is list && d.progression.trueClassSkills.size() <= 4
            && d.progression.levelHistory is list && d.progression.levelHistory.size() <= 10
            && d.derivedStats is map
            && d.derivedStats.keys().hasOnly([
              'mode','formulaVersion','carryWeight','carryCapacity','initiative'
            ])
            && d.derivedStats.keys().hasAll([
              'mode','formulaVersion','carryWeight','carryCapacity','initiative'
            ])
            && d.derivedStats.mode in ['manual','partial','calculated']
            && d.derivedStats.formulaVersion is string && d.derivedStats.formulaVersion.size() <= 32
            && d.derivedStats.carryWeight is number
            && d.derivedStats.carryWeight >= 0 && d.derivedStats.carryWeight <= 100000
            && d.derivedStats.carryCapacity is number
            && d.derivedStats.carryCapacity >= 0 && d.derivedStats.carryCapacity <= 100000
            && d.derivedStats.initiative is number
            && d.derivedStats.initiative >= -100 && d.derivedStats.initiative <= 100
            && d.wallet is map
            && d.wallet.keys().hasOnly(['coins','other'])
            && d.wallet.keys().hasAll(['coins','other'])
            && d.wallet.coins is int && d.wallet.coins >= 0 && d.wallet.coins <= 1000000000
            && d.wallet.other is map && d.wallet.other.size() <= 10
            && d.equipmentSlots is map
            && d.equipmentSlots.keys().hasOnly([
              'mainHand','offHand','armor','accessory1','accessory2','special'
            ])
            && d.equipmentSlots.keys().hasAll([
              'mainHand','offHand','armor','accessory1','accessory2','special'
            ])
            && d.equipmentSlots.mainHand is string && d.equipmentSlots.mainHand.size() <= 64
            && d.equipmentSlots.offHand is string && d.equipmentSlots.offHand.size() <= 64
            && d.equipmentSlots.armor is string && d.equipmentSlots.armor.size() <= 64
            && d.equipmentSlots.accessory1 is string && d.equipmentSlots.accessory1.size() <= 64
            && d.equipmentSlots.accessory2 is string && d.equipmentSlots.accessory2.size() <= 64
            && d.equipmentSlots.special is string && d.equipmentSlots.special.size() <= 64;
        }

        // Planned V2 inventory. Items are separate documents, not an ever-growing
        // array in the character document. This can be used without Storage.
        match /items/{itemId} {
          function characterExists() {
            return exists(/databases/$(database)/documents/users/$(uid)/characters/$(characterId));
          }
          function validItem() {
            let d = request.resource.data;
            return d.keys().hasOnly([
                'catalogId','name','category','rarity','quantity','unitWeight',
                'unitPrice','notes','equippedSlot','createdAt','updatedAt'
              ])
              && d.keys().hasAll([
                'catalogId','name','category','rarity','quantity','unitWeight',
                'unitPrice','notes','equippedSlot','createdAt','updatedAt'
              ])
              && d.catalogId is string && d.catalogId.size() <= 80
              && d.name is string && d.name.size() >= 1 && d.name.size() <= 120
              && d.category in ['weapon','armor','accessory','consumable','material','quest','misc']
              && d.rarity is string && d.rarity.size() <= 32
              && d.quantity is int && d.quantity >= 1 && d.quantity <= 9999
              && d.unitWeight is number && d.unitWeight >= 0 && d.unitWeight <= 100000
              && d.unitPrice is number && d.unitPrice >= 0 && d.unitPrice <= 1000000000
              && d.notes is string && d.notes.size() <= 1000
              && d.equippedSlot is string && d.equippedSlot.size() <= 32
              && d.updatedAt == request.time;
          }
          allow get, list: if own(uid);
          allow create: if own(uid) && characterExists()
            && itemId.matches('^[A-Za-z0-9_-]{1,64}$')
            && validItem() && request.resource.data.createdAt == request.time;
          allow update: if own(uid) && characterExists()
            && validItem() && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if own(uid);
        }

      }
    }

    match /parties/{pid} {
      allow get: if signed() && request.auth.uid in resource.data.memberIds;
      allow list: if false;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['leaderId','name','description','emblemData','memberIds','regionId','note','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['leaderId','name','description','emblemData','memberIds','regionId','note','createdAt','updatedAt'])
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 50
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.emblemData is string && request.resource.data.emblemData.size() <= 110000
        && request.resource.data.regionId is string && request.resource.data.regionId.size() <= 48
        && request.resource.data.note is string && request.resource.data.note.size() <= 350
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (
          (leader(pid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','emblemData','memberIds','regionId','note','updatedAt'])
            && request.resource.data.leaderId == resource.data.leaderId
            && request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() <= 6
            && validPartyAddition(pid)
            && resource.data.leaderId in request.resource.data.memberIds
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 50
            && request.resource.data.description is string && request.resource.data.description.size() <= 500
            && request.resource.data.emblemData is string && request.resource.data.emblemData.size() <= 110000
            && request.resource.data.regionId is string && request.resource.data.regionId.size() <= 48
            && request.resource.data.note is string && request.resource.data.note.size() <= 350)
          ||
          (member(pid) && request.auth.uid != resource.data.leaderId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','updatedAt'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]))
        ) && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /requests/{requesterId} {
        allow get: if own(requesterId) || leader(pid);
        allow list: if leader(pid);
        allow create: if own(requesterId) && partyExists(pid)
          && !(request.auth.uid in get(/databases/$(database)/documents/parties/$(pid)).data.memberIds)
          && request.resource.data.keys().hasOnly(['uid','displayName','status','createdAt'])
          && request.resource.data.keys().hasAll(['uid','displayName','status','createdAt'])
          && request.resource.data.uid == requesterId
          && validName(request.resource.data.displayName)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if leader(pid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.respondedAt == request.time;
        allow delete: if own(requesterId) && resource.data.status in ['pending','rejected'];
      }

      match /roster/{memberUid} {
        allow get, list: if member(pid);
        allow create, update: if own(memberUid) && member(pid)
          && request.resource.data.keys().hasOnly(['uid','characterId','characterName','className','level','health','healthMax','mana','manaMax','status','updatedAt'])
          && request.resource.data.uid == memberUid
          && request.resource.data.characterName is string && request.resource.data.characterName.size() <= 40
          && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 10
          && request.resource.data.health is number && request.resource.data.health >= 0
          && request.resource.data.healthMax is number && request.resource.data.healthMax >= 0
          && request.resource.data.mana is number && request.resource.data.mana >= 0
          && request.resource.data.manaMax is number && request.resource.data.manaMax >= 0
          && request.resource.data.updatedAt == request.time;
        allow delete: if own(memberUid) && member(pid);
      }
    }

    // A future privileged publishing backend will write announcements.
    // Nobody can publish from the browser by editing their account role.
    match /announcements/{announcementId} {
      allow get, list: if signed() && resource.data.published == true;
      allow create, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
